# Copy to .env (never commit .env). All values are empty on purpose.

# Local Playwright tests (e2e/)
E2E_BASE_URL=
E2E_USER=
E2E_PASSWORD=
E2E_FULL_NAME=

# Later phases (fill only when the phase needs them)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
PAYMOB_API_KEY=
PAYMOB_HMAC_SECRET=
BREVO_SMTP_USER=
BREVO_SMTP_PASSWORD=

# Phase 16: Web Push (put the real values in site_config.json: vapid_public_key, vapid_private_key,
# vapid_subject). Generate a pair with:
#   bench --site <site> execute construction_core.push.generate_vapid_keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
