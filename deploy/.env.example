# Production stack settings (copy to deploy/.env on the server; never commit .env).
# The image built by .github/workflows/image.yml for a tag vX.Y.Z:
CUSTOM_IMAGE=ghcr.io/ammarshatta/inceptiondesign
CUSTOM_TAG=
# Domain served by the proxy (Cloudflare in front, "Full (strict)")
SITE_NAME=
LETSENCRYPT_EMAIL=
# Database
DB_PASSWORD=
# Backups: rclone remote names (configured on the server with `rclone config`, crypt over R2)
RCLONE_REMOTE=r2crypt:inceptiondesign-backups
BACKUP_KEEP_DAYS=30
ALERT_EMAIL=
