 "font_size": 12,
 "html": "{%- set b = get_branding() -%}\n<div dir=\"rtl\" lang=\"ar\" style=\"font-family: 'IBM Plex Sans Arabic', 'DejaVu Sans', Tahoma, sans-serif; color: #17201D; font-size: 12px\">\n  <table style=\"width:100%; border-collapse:collapse; margin-bottom:16px\">\n    <tr>\n      <td style=\"vertical-align:top\">\n        {% if b.logo %}<img src=\"{{ b.logo }}\" style=\"max-height:56px\"><br>{% endif %}\n        <b style=\"font-size:16px\">{{ b.office_name or doc.company }}</b>\n      </td>\n      <td style=\"vertical-align:top; text-align:left\">\n        <b style=\"font-size:18px\">فاتورة</b><br>\n        <span dir=\"ltr\">{{ doc.name }}</span><br>\n        التاريخ: <span dir=\"ltr\">{{ frappe.utils.formatdate(doc.posting_date, \"dd-MM-yyyy\") }}</span>\n      </td>\n    </tr>\n  </table>\n  <p>العميل: <b>{{ doc.customer_name }}</b>{% if doc.project %} · المشروع: <b>{{ frappe.db.get_value(\"Project\", doc.project, \"project_name\") }}</b>{% endif %}</p>\n  <table style=\"width:100%; border-collapse:collapse; margin-top:8px\">\n    <thead>\n      <tr style=\"background:#E3F0EB\">\n        <th style=\"border:1px solid #C9CFC9; padding:6px; text-align:right\">البند</th>\n        <th style=\"border:1px solid #C9CFC9; padding:6px\">الكمية</th>\n        <th style=\"border:1px solid #C9CFC9; padding:6px\">السعر</th>\n        <th style=\"border:1px solid #C9CFC9; padding:6px\">الإجمالي</th>\n      </tr>\n    </thead>\n    <tbody>\n      {% for item in doc.items %}\n      <tr>\n        <td style=\"border:1px solid #C9CFC9; padding:6px\">{{ item.item_name }}{% if item.description and item.description != item.item_name %}<br><small>{{ item.description | striptags }}</small>{% endif %}</td>\n        <td style=\"border:1px solid #C9CFC9; padding:6px; text-align:center\" dir=\"ltr\">{{ item.get_formatted(\"qty\") }}</td>\n        <td style=\"border:1px solid #C9CFC9; padding:6px; text-align:center\" dir=\"ltr\">{{ item.get_formatted(\"rate\") }}</td>\n        <td style=\"border:1px solid #C9CFC9; padding:6px; text-align:center\" dir=\"ltr\">{{ item.get_formatted(\"amount\") }}</td>\n      </tr>\n      {% endfor %}\n    </tbody>\n  </table>\n  <table style=\"width:50%; margin-top:12px; margin-right:auto; border-collapse:collapse\">\n    <tr><td style=\"padding:4px\">الإجمالي</td><td style=\"padding:4px; text-align:left\" dir=\"ltr\">{{ doc.get_formatted(\"net_total\") }}</td></tr>\n    {% for tax in doc.taxes %}<tr><td style=\"padding:4px\">{{ tax.description }}</td><td style=\"padding:4px; text-align:left\" dir=\"ltr\">{{ tax.get_formatted(\"tax_amount\") }}</td></tr>{% endfor %}\n    <tr style=\"font-weight:bold; border-top:2px solid #17201D\"><td style=\"padding:4px\">المطلوب</td><td style=\"padding:4px; text-align:left\" dir=\"ltr\">{{ doc.get_formatted(\"grand_total\") }}</td></tr>\n    {% if doc.outstanding_amount != doc.grand_total %}<tr><td style=\"padding:4px\">المتبقي</td><td style=\"padding:4px; text-align:left\" dir=\"ltr\">{{ doc.get_formatted(\"outstanding_amount\") }}</td></tr>{% endif %}\n  </table>\n  {% if doc.in_words %}<p style=\"margin-top:12px\">المبلغ بالحروف: {{ doc.in_words }}</p>{% endif %}\n</div>",
