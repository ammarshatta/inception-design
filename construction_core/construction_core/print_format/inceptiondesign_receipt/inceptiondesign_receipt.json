 "html": "{%- set b = get_branding() -%}\n<div dir=\"rtl\" lang=\"ar\" style=\"font-family: 'IBM Plex Sans Arabic', 'DejaVu Sans', Tahoma, sans-serif; color: #17201D; font-size: 12px\">\n  <table style=\"width:100%; border-collapse:collapse; margin-bottom:16px\">\n    <tr>\n      <td style=\"vertical-align:top\">\n        {% if b.logo %}<img src=\"{{ b.logo }}\" style=\"max-height:56px\"><br>{% endif %}\n        <b style=\"font-size:16px\">{{ b.office_name or doc.company }}</b>\n      </td>\n      <td style=\"vertical-align:top; text-align:left\">\n        <b style=\"font-size:18px\">إيصال استلام نقدية</b><br>\n        <span dir=\"ltr\">{{ doc.name }}</span><br>\n        التاريخ: <span dir=\"ltr\">{{ frappe.utils.formatdate(doc.posting_date, \"dd-MM-yyyy\") }}</span>\n      </td>\n    </tr>\n  </table>\n  <p>استلمنا من: <b>{{ doc.party_name or doc.party }}</b>{% if doc.project %} · المشروع: <b>{{ frappe.db.get_value(\"Project\", doc.project, \"project_name\") }}</b>{% endif %}</p>\n  <p style=\"font-size:16px\">مبلغ وقدره: <b dir=\"ltr\">{{ \"{:,.2f}\".format(doc.paid_amount) }}</b> ج.م</p>\n  {% if doc.references %}\n  <table style=\"width:100%; border-collapse:collapse; margin-top:8px\">\n    <tr style=\"background:#E3F0EB\"><th style=\"border:1px solid #C9CFC9; padding:6px; text-align:right\">عن الفاتورة</th><th style=\"border:1px solid #C9CFC9; padding:6px\">المبلغ</th></tr>\n    {% for r in doc.references %}<tr><td style=\"border:1px solid #C9CFC9; padding:6px\" dir=\"ltr\">{{ r.reference_name }}</td><td style=\"border:1px solid #C9CFC9; padding:6px; text-align:center\" dir=\"ltr\">{{ \"{:,.2f}\".format(r.allocated_amount) }}</td></tr>{% endfor %}\n  </table>\n  {% endif %}\n  <p>المرجع: <span dir=\"ltr\">{{ doc.reference_no or \"\" }}</span></p>\n  <p style=\"color:#5B6661\">إيصال صادر من النظام بدون توقيع.</p>\n</div>",
