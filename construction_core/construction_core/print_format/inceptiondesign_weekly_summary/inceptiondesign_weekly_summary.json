 "html": "{%- set b = get_branding() -%}{%- set s = owner_summary() -%}{%- set d = s.dashboard -%}\n<div dir=\"rtl\" lang=\"ar\" style=\"font-family: 'IBM Plex Sans Arabic', 'DejaVu Sans', Tahoma, sans-serif; color:#17201D; font-size:11px\">\n<p><b style=\"font-size:16px\">{{ b.office_name }}</b> — ملخص الأسبوع <span dir=\"ltr\">{{ frappe.utils.formatdate(frappe.utils.nowdate(), \"dd-MM-yyyy\") }}</span></p>\n<table style=\"width:100%;border-collapse:collapse;margin-bottom:10px\">\n<tr style=\"background:#E3F0EB\"><th style=\"border:1px solid #C9CFC9; padding:5px\">مشاريع شغالة</th><th style=\"border:1px solid #C9CFC9; padding:5px\">فوترة زيادة/ناقص</th><th style=\"border:1px solid #C9CFC9; padding:5px\">مستحق على العملاء</th><th style=\"border:1px solid #C9CFC9; padding:5px\">متأخر</th><th style=\"border:1px solid #C9CFC9; padding:5px\">مشاريع متأخرة</th><th style=\"border:1px solid #C9CFC9; padding:5px\">فرص مفتوحة</th></tr>\n<tr><td style=\"border:1px solid #C9CFC9; padding:5px;text-align:center\" dir=\"ltr\">{{ d.active_projects }}</td><td style=\"border:1px solid #C9CFC9; padding:5px;text-align:center\" dir=\"ltr\">{{ \"{:,.0f}\".format(d.over_under) }}</td><td style=\"border:1px solid #C9CFC9; padding:5px;text-align:center\" dir=\"ltr\">{{ \"{:,.0f}\".format(d.receivables) }}</td><td style=\"border:1px solid #C9CFC9; padding:5px;text-align:center\" dir=\"ltr\">{{ \"{:,.0f}\".format(d.overdue) }}</td><td style=\"border:1px solid #C9CFC9; padding:5px;text-align:center\" dir=\"ltr\">{{ d.late_projects }}</td><td style=\"border:1px solid #C9CFC9; padding:5px;text-align:center\" dir=\"ltr\">{{ \"{:,.0f}\".format(d.pipeline_value) }}</td></tr>\n</table>\n<h3>المشاريع (أعمال تحت التنفيذ)</h3>\n<table style=\"width:100%;border-collapse:collapse\">\n<tr style=\"background:#E3F0EB\"><th style=\"border:1px solid #C9CFC9; padding:5px;text-align:right\">المشروع</th><th style=\"border:1px solid #C9CFC9; padding:5px\">الإنجاز</th><th style=\"border:1px solid #C9CFC9; padding:5px\">المكتسبة</th><th style=\"border:1px solid #C9CFC9; padding:5px\">المفوتر</th><th style=\"border:1px solid #C9CFC9; padding:5px\">الهامش المتوقع</th></tr>\n{% for r in s.wip %}<tr><td style=\"border:1px solid #C9CFC9; padding:5px\">{{ r.project_name or r.project }}</td><td style=\"border:1px solid #C9CFC9; padding:5px;text-align:center\" dir=\"ltr\">{{ \"{:.0f}\".format(r.complete) }}%</td><td style=\"border:1px solid #C9CFC9; padding:5px;text-align:center\" dir=\"ltr\">{{ \"{:,.0f}\".format(r.earned) }}</td><td style=\"border:1px solid #C9CFC9; padding:5px;text-align:center\" dir=\"ltr\">{{ \"{:,.0f}\".format(r.billed) }}</td><td style=\"border:1px solid #C9CFC9; padding:5px;text-align:center\" dir=\"ltr\">{{ \"{:,.0f}\".format(r.margin) }}</td></tr>{% endfor %}\n</table>\n{% if s.late %}<h3>متأخرة</h3><ul>{% for r in s.late %}<li>{{ r.project_name or r.project }}: {{ r.stage }} — {{ r.days_late }} يوم</li>{% endfor %}</ul>{% endif %}\n</div>",
